<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".prestory">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4E4F87">

        <ImageView
            android:id="@+id/sword"
            android:layout_width="414dp"
            android:layout_height="412dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/malinkundang" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="461dp"
            android:layout_height="98dp"
            android:layout_marginTop="412dp"
            android:layout_marginBottom="225dp"
            android:background="@drawable/box_blue"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0" />

        <Button
            android:id="@+id/button"
            android:layout_width="280dp"
            android:layout_height="59dp"
            android:layout_marginStart="65dp"
            android:layout_marginTop="380dp"
            android:backgroundTint="#2C8FE9"
            android:fontFamily="@font/poppins_semibold"
            android:text="Start Reading"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/TextView3"
            android:layout_width="30dp"
            android:layout_height="40dp"
            android:layout_marginStart="227dp"
            android:layout_marginTop="442dp"
            android:layout_marginEnd="154dp"
            android:background="@drawable/box_grey"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="30dp"
            android:layout_height="40dp"
            android:layout_marginStart="154dp"
            android:layout_marginTop="441dp"
            android:background="@drawable/box_grey"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="26dp"
            android:layout_height="33dp"
            android:layout_marginStart="156dp"
            android:layout_marginTop="444dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/addtolist" />

        <ImageView
            android:id="@+id/imageView5"
            android:layout_width="26dp"
            android:layout_height="36dp"
            android:layout_marginStart="230dp"
            android:layout_marginTop="442dp"
            android:layout_marginEnd="155dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/like" />

        <TextView
            android:id="@+id/like"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="233dp"
            android:layout_marginTop="484dp"
            android:layout_marginEnd="159dp"
            android:fontFamily="@font/poppins_medium"
            android:text="Like"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/addtolist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="145dp"
            android:layout_marginTop="484dp"
            android:layout_marginEnd="215dp"
            android:fontFamily="@font/poppins_medium"
            android:text="Add to list"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageView12"
            android:layout_width="46dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="512dp"
            android:layout_marginEnd="207dp"
            android:layout_marginBottom="177dp"
            android:fontFamily="@font/poppins_bold"
            android:text="Malin Kundang"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView6"
            android:layout_width="385dp"
            android:layout_height="113dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="552dp"
            android:fontFamily="@font/poppins"
            android:text="Malin Kundang adalah pemuda miskin yang merantau untuk mengubah nasib. Setelah bertahun-tahun, ia sukses menjadi saudagar kaya dan menikah dengan wanita bangsawan. Ketika kembali ke kampung halamannya, ia malu mengakui ibunya yang miskin. Sang ibu merasa sedih dan kecewa karena anaknya durhaka. Ia pun berdoa agar Malin mendapat balasan atas perbuatannya. Tak lama kemudian, kapal Malin dihantam badai, dan ia berubah menjadi batu. Kisah ini mengajarkan pentingnya berbakti kepada orang tua dan tidak melupakan asal-usul."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>